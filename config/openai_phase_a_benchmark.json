{
  "version": "openai-planning-phase-a-config-v1",
  "dataset_split": "public-split-v1-development-only",
  "models": [
    {
      "role": "quality_reference",
      "model": "gpt-5.6-sol",
      "pricing_usd_per_million_tokens": {
        "input": 4.0,
        "output": 20.0
      }
    },
    {
      "role": "lower_cost",
      "model": "gpt-5.6-luna",
      "pricing_usd_per_million_tokens": {
        "input": 0.2,
        "output": 1.2
      }
    }
  ],
  "api": {
    "endpoint": "responses-v1",
